+// SPDX-License-Identifier: GPL-2.0-or-later
+// Copyright The XCSoar Project
+
+#include "Device/Driver/OatHid.hpp"
+#include "Device/Driver.hpp"
+#include "Device/Driver/OatHid/Parser.hpp"
+#include "NMEA/Info.hpp"
+
+#include <array>
+
+class OatHidDevice final : public AbstractDevice {
+  std::array<std::byte, 4> pending{};
+  std::size_t pending_size = 0;
+
+public:
+  /* virtual methods from class Device */
+  bool DataReceived(std::span<const std::byte> s,
+                    NMEAInfo &info) noexcept override;
+};
+
+bool
+OatHidDevice::DataReceived(std::span<const std::byte> s,
+                           NMEAInfo &info) noexcept
+{
+  bool recognized = false;
+
+  for (const std::byte byte : s) {
+    pending[pending_size++] = byte;
+    if (pending_size < pending.size())
+      continue;
+
+    pending_size = 0;
+    const OatHid::Report report = OatHid::Parse(pending);
+    if (!report.recognized)
+      continue;
+
+    /* a fault still means the probe is connected */
+    info.alive.Update(info.clock);
+    recognized = true;
+
+    if (!report.ok)
+      continue;
+
+    info.temperature =
+      Temperature::FromCelsius(report.hundredths / 100.);
+    info.temperature_available.Update(info.clock);
+  }
+
+  return recognized;
+}
+
+static Device *
+OatHidCreateOnPort(const DeviceConfig &, Port &)
+{
+  return new OatHidDevice();
+}
+
+const struct DeviceRegister oat_hid_driver = {
+  "OatHid",
+  "OAT HID",
+  DeviceRegister::RAW_GPS_DATA | DeviceRegister::NO_TIMEOUT,
+  OatHidCreateOnPort,
+};
diff --git a/src/Device/Driver/OatHid/Parser.cpp b/src/Device/Driver/OatHid/Parser.cpp
new file mode 100644
index 000000000..e0bdb2224
--- /dev/null
+++ b/src/Device/Driver/OatHid/Parser.cpp
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Copyright The XCSoar Project
+
+#include "Parser.hpp"
+
+namespace OatHid {
+
+static constexpr uint8_t REPORT_ID = 1;
+static constexpr uint8_t STATUS_OK = 0;
+static constexpr uint8_t STATUS_FAULT = 1;
+static constexpr std::size_t REPORT_SIZE = 4;
+
+Report
+Parse(std::span<const std::byte> bytes) noexcept
+{
+  Report report;
+  if (bytes.size() != REPORT_SIZE)
+    return report;
+
+  if (static_cast<uint8_t>(bytes[0]) != REPORT_ID)
+    return report;
+
+  const uint8_t status = static_cast<uint8_t>(bytes[3]);
+  if (status != STATUS_OK && status != STATUS_FAULT)
+    return report;
+
+  const unsigned lo = static_cast<uint8_t>(bytes[1]);
+  const unsigned hi = static_cast<uint8_t>(bytes[2]);
+  report.recognized = true;
+  report.ok = status == STATUS_OK;
+  report.hundredths = static_cast<int16_t>(lo | (hi << 8));
+  return report;
+}
+
+} // namespace OatHid
